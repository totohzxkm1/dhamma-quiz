[
  {"subject":"วิชาธรรม","category":"ทุกะ หมวด ๒","question":"ธรรมที่ได้ชื่อว่ามีอุปการะมาก คือธรรมอะไร ? เพราะเหตุไรจึงจัดว่ามีอุปการะมาก ?","answer":"คือ สติ ความระลึกได้ และสัมปชัญญะ ความรู้ตัว เพราะเป็นคุณธรรมอุดหนุนให้สำเร็จประโยชน์เกื้อกูลในกิจทั้งปวง"},
  {"subject":"วิชาธรรม","category":"ทุกะ หมวด ๒","question":"ธรรมที่ทำบุคคลให้งาม คือธรรมอะไร ?","answer":"คือ ขันติ ความอดทน และโสรัจจะ ความสงบเสงี่ยม"},
  {"subject":"วิชาธรรม","category":"ทุกะ หมวด ๒","question":"บุพพการีและกตัญญูกตเวที ได้แก่บุคคลเช่นไร ?","answer":"บุพพการี ได้แก่บุคคลผู้ทำอุปการะก่อน กตัญญูกตเวที ได้แก่บุคคลผู้รู้อุปการะที่ท่านทำแล้ว และทำตอบแทน"},
  {"subject":"วิชาธรรม","category":"ติกะ หมวด ๓","question":"ทุจริต คืออะไร ? พูดใส่ร้ายผู้อื่น จัดเข้าในทุจริตข้อไหน ?","answer":"ทุจริต คือ ความประพฤติชั่ว ความประพฤติเสียหาย จัดเข้าในวจีทุจริต"},
  {"subject":"วิชาธรรม","category":"ติกะ หมวด ๓","question":"มูลเหตุที่ทำให้บุคคลทำความชั่วเรียกว่าอะไร ? มีอะไรบ้าง ?","answer":"เรียกว่า อกุศลมูล หมายถึง รากเหง้าของอกุศล มี ๓ คือ โลภะ อยากได้ โทสะ คิดประทุษร้ายเขา โมหะ หลงไม่รู้จริง"},
  {"subject":"วิชาธรรม","category":"ติกะ หมวด ๓","question":"ไตรลักษณะ ได้แก่อะไรบ้าง ?","answer":"อนิจจตา ความเป็นของไม่เที่ยง ทุกขตา ความเป็นทุกข์ อนัตตตา ความเป็นของไม่ใช่ตน"},
  {"subject":"วิชาธรรม","category":"จตุกกะ หมวด ๔","question":"บุคคลผู้หวังความเจริญ ควรตั้งอยู่ในธรรมอะไร ? มีอะไรบ้าง ?","answer":"ควรตั้งอยู่ในวุฑฒิธรรม มี คบสัตบุรุษ ฟังคำสั่งสอนของท่านโดยเคารพ ตริตรองให้รู้จักสิ่งที่ดีหรือชั่วโดยอุบายที่ชอบ ประพฤติธรรมสมควรแก่ธรรมซึ่งได้ตรองเห็นแล้ว"},
  {"subject":"วิชาธรรม","category":"จตุกกะ หมวด ๔","question":"พรหมวิหาร ๔ มีอะไรบ้าง ?","answer":"เมตตา ความรัก กรุณา ความสงสาร มุทิตา ความพลอยยินดี อุเบกขา ความวางเฉย"},
  {"subject":"วิชาธรรม","category":"จตุกกะ หมวด ๔","question":"อริยสัจ ๔ มีอะไรบ้าง ?","answer":"ทุกข์ สมุทัย นิโรธ มรรค"},
  {"subject":"วิชาธรรม","category":"ปัญจกะ หมวด ๕","question":"กรรมที่เป็นบาปหนักที่สุด ชื่อเรียกว่าอะไร ? คืออะไรบ้าง ?","answer":"เรียกว่า อนันตริยกรรม คือ มาตุฆาต ฆ่ามารดา ปิตุฆาต ฆ่าบิดา อรหันตฆาต ฆ่าพระอรหันต์ โลหิตุปบาท ทำร้ายพระพุทธเจ้าจนถึงยังพระโลหิตให้ห้อขึ้นไป สังฆเภท ยังสงฆ์ให้แตกจากกัน"},
  {"subject":"วิชาธรรม","category":"ฉักกะ หมวด ๖","question":"อายตนะภายใน ๖ ได้แก่อะไรบ้าง ?","answer":"ได้แก่ ตา หู จมูก ลิ้น กาย ใจ"},
  {"subject":"วิชาธรรม","category":"อัฏฐกะ หมวด ๘","question":"โลกธรรม ธรรมที่ครอบงำสัตว์โลก ๘ อย่างนั้นมีอะไรบ้าง ?","answer":"มีลาภ ไม่มีลาภ มียศ ไม่มียศ นินทา สรรเสริญ สุข ทุกข์"},
  {"subject":"วิชาธรรม","category":"คิหิปฏิบัติ","question":"ศีลที่คฤหัสถ์ควรรักษาเป็นนิตย์ คือศีลอะไร ?","answer":"คือ ศีล ๕"},
  {"subject":"วิชาธรรม","category":"คิหิปฏิบัติ","question":"อบายมุข ๔ มีอะไรบ้าง ?","answer":"ความเป็นนักเลงหญิง ความเป็นนักเลงสุรา ความเป็นนักเลงเล่นการพนัน ความคบคนชั่วเป็นมิตร"},
  {"subject":"วิชาพุทธประวัติ","category":"ปริเฉทที่ ๑ ชมพูทวีปและประชาชน","question":"ประชาชนในชมพูทวีป มีกี่จำพวก ? พระพุทธเจ้าสืบเชื้อสายมาจากชนชาติใด ?","answer":"มี ๒ จำพวก คือ มิลักขะ เจ้าของถิ่นเดิม และอริยกะ พวกอพยพมาใหม่ สืบเชื้อสายมาจากชนชาติอริยกะ"},
  {"subject":"วิชาพุทธประวัติ","category":"ปริเฉทที่ ๓ พระศาสดาประสูติ","question":"พระพุทธเจ้าประสูติที่ไหน ? เมื่อไร ?","answer":"ที่ลุมพินีวัน ระหว่างกรุงกบิลพัสดุ์กับกรุงเทวทหะ วันเพ็ญเดือน ๖ ก่อนพุทธศก ๘๐ ปี"},
  {"subject":"วิชาพุทธประวัติ","category":"ปริเฉทที่ ๔ เสด็จออกบรรพชา","question":"เจ้าชายสิทธัตถะทรงปรารภอะไรจึงเสด็จออกบรรพชา ? หลังจากบรรพชาแล้วกี่ปีจึงตรัสรู้ ?","answer":"ทรงปรารภความแก่ ความเจ็บ ความตาย และสมณะ (เทวทูต ๔) บรรพชาได้ ๖ ปี จึงตรัสรู้"},
  {"subject":"วิชาพุทธประวัติ","category":"ปริเฉทที่ ๖ ปฐมเทศนาและปฐมสาวก","question":"ปฐมสาวกและปัจฉิมสาวก คือใคร ?","answer":"ปฐมสาวก คือ พระอัญญาโกณฑัญญะ ปัจฉิมสาวก คือ พระสุภัททะ"},
  {"subject":"วิชาพุทธประวัติ","category":"ปริเฉทที่ ๖ ปฐมเทศนาและปฐมสาวก","question":"เทศนากัณฑ์แรก ชื่ออะไร ? ทรงแสดงแก่ใคร ?","answer":"เทศนากัณฑ์แรก ชื่อธัมมจักกัปปวัตตนสูตร ทรงแสดงแก่พระปัญจวัคคีย์"},
  {"subject":"วิชาพุทธประวัติ","category":"ปริเฉทที่ ๘ เสด็จกรุงราชคฤห์","question":"พระอัครสาวกทั้ง ๒ องค์สำเร็จเป็นพระโสดาบัน เพราะฟังธรรมจากใคร ?","answer":"พระสารีบุตร ฟังธรรมจากพระอัสสชิเถระ พระโมคคัลลานะ ฟังธรรมจากพระสารีบุตร"},
  {"subject":"วิชาพุทธประวัติ","category":"ปริเฉทที่ ๑๒ ปรินิพพาน","question":"ถูปารหบุคคล มีกี่ประเภท ? คือใครบ้าง ?","answer":"มี ๔ ประเภท คือ พระสัมมาสัมพุทธเจ้า พระปัจเจกพุทธเจ้า พระอรหันตสาวก พระเจ้าจักรพรรดิราช"},
  {"subject":"วิชาศาสนพิธี","category":"หมวดที่ ๑ กุศลพิธี","question":"วันสำคัญทางพระพุทธศาสนา กำหนดไว้กี่วัน ? คือวันอะไรบ้าง ?","answer":"กำหนดไว้ ๔ วัน คือ วันมาฆบูชา วันวิสาขบูชา วันอัฏฐมีบูชา และวันอาสาฬหบูชา"},
  {"subject":"วิชาศาสนพิธี","category":"หมวดที่ ๔ ปกิณกพิธี","question":"การแสดงความเคารพพระภิกษุมีกี่วิธี ? อะไรบ้าง ?","answer":"มี ๓ วิธี คือ ประนมมือ (ทำอัญชลี) ไหว้ (นมัสการ) กราบ (อภิวาท)"},
  {"subject":"วิชาวินัยบัญญัติ","category":"กัณฑ์ที่ ๑ อุปสัมปทา","question":"นิสสัยคืออะไร ? มีอะไรบ้าง ?","answer":"คือ ปัจจัยเครื่องอาศัยของบรรพชิต มี เที่ยวบิณฑบาต นุ่งห่มผ้าบังสุกุล อยู่โคนต้นไม้ ฉันยาดองด้วยน้ำมูตรเน่า"},
  {"subject":"วิชาวินัยบัญญัติ","category":"กัณฑ์ที่ ๒ พระวินัย","question":"อาบัติ คืออะไร ? ว่าโดยชื่อมีอะไรบ้าง ?","answer":"อาบัติ คือ โทษที่เกิดเพราะความละเมิดในข้อที่พระพุทธเจ้าห้าม มี ปาราชิก สังฆาทิเสส ถุลลัจจัย ปาจิตตีย์ ปาฏิเทสนียะ ทุกกฎ ทุพภาสิต"},
  {"subject":"วิชาวินัยบัญญัติ","category":"กัณฑ์ที่ ๔ ปาราชิก ๔","question":"ภิกษุฆ่ามนุษย์ ฆ่าสัตว์เดียรัจฉาน ต้องอาบัติอะไร ?","answer":"ฆ่ามนุษย์ ต้องอาบัติปาราชิก ฆ่าสัตว์เดียรัจฉาน ต้องอาบัติปาจิตตีย์"},
  {"subject":"วิชาวินัยบัญญัติ","category":"กัณฑ์ที่ ๕ สังฆาทิเสส ๑๓","question":"สังฆาทิเสส มีกี่สิกขาบท ? ภิกษุต้องอาบัตินี้จะพ้นได้ด้วยวิธีอย่างไร ?","answer":"มี ๑๓ สิกขาบท ด้วยวิธีอยู่กรรม ที่เรียกว่า วุฏฐานคามินี"},
  {"subject":"วิชาวินัยบัญญัติ","category":"กัณฑ์ที่ ๙ อธิกรณสมถะ ๗","question":"อธิกรณ์ คืออะไร ? อธิกรณสมถะ คืออะไร ?","answer":"อธิกรณ์ คือ เรื่องที่เกิดขึ้นแล้วจะต้องจัดต้องทำ อธิกรณสมถะ คือ ธรรมเครื่องระงับอธิกรณ์"}